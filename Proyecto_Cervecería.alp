			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1729455782005</Id>
					<Name><![CDATA[tiempoMolienda]]></Name>
					<X>450</X><Y>-90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tipo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[    int tiempo = 0;

    if (tipo.equalsIgnoreCase("Base")) {
        tiempo = 10;
    } else if (tipo.equalsIgnoreCase("Especial")) {
        tiempo = 8;
    } else if (tipo.equalsIgnoreCase("Tostada")) {
        tiempo = 12;
    } else if (tipo.equalsIgnoreCase("Oscura")) {
        tiempo = 15;
    } else if (tipo.equalsIgnoreCase("Trigo")) {
        tiempo = 13;
    } else {
        tiempo = 5;
    }

    return tiempo;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1729457173059</Id>
					<Name><![CDATA[cantidadLupulo]]></Name>
					<X>450</X><Y>-70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tipo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[    double factorLupulo;
    
    switch (tipo.toLowerCase()) {
        case "ipa":
            factorLupulo = 0.08;
            break;
        case "lager":
            factorLupulo = 0.04;
            break;
        case "ale":
            factorLupulo = 0.05;
            break;
        case "stout":
            factorLupulo = 0.03;
            break;
        default:
            factorLupulo = 0.05;
            break;
    }
     return (int) Math.ceil(500 * factorLupulo);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1729459503122</Id>
					<Name><![CDATA[tiempoEtapa]]></Name>
					<X>450</X><Y>-110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tipoDeCerveza]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[etapa]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[    int tiempoBase = 0;
   
    switch (tipoDeCerveza.toLowerCase()) {
        case "ipa":
            tiempoBase = (etapa.equalsIgnoreCase("maceración")) ? 60 : // Minutos
                         (etapa.equalsIgnoreCase("fermentación")) ? 10 : // Días
                         (etapa.equalsIgnoreCase("maduración")) ? 3 : // Semanas
                         (etapa.equalsIgnoreCase("hervido")) ? 90 : 0; // Minutos
            break;
        case "lager":
            tiempoBase = (etapa.equalsIgnoreCase("maceración")) ? 50 : 
                         (etapa.equalsIgnoreCase("fermentación")) ? 14 : 
                         (etapa.equalsIgnoreCase("maduración")) ? 4 : 
                         (etapa.equalsIgnoreCase("hervido")) ? 60 : 0;
            break;
        case "stout":
            tiempoBase = (etapa.equalsIgnoreCase("maceración")) ? 45 : 
                         (etapa.equalsIgnoreCase("fermentación")) ? 7 : 
                         (etapa.equalsIgnoreCase("maduración")) ? 4 : 
                         (etapa.equalsIgnoreCase("hervido")) ? 75 : 0;
            break;
        default:
            tiempoBase = (etapa.equalsIgnoreCase("maceración")) ? 55 : 
                         (etapa.equalsIgnoreCase("fermentación")) ? 10 : 
                         (etapa.equalsIgnoreCase("maduración")) ? 3 : 
                         (etapa.equalsIgnoreCase("hervido")) ? 60 : 0;
            break;
    }
    
    double cantidadLupulo = cantidadLupulo(tipoDeCerveza);
    
    
    if (etapa.equalsIgnoreCase("hervido") && cantidadLupulo > 5.0) { 
        tiempoBase += 15;
    }

    return tiempoBase;
]]></Body>
				</Function>
