			<DestroyCode><![CDATA[System.out.println("Estadísticas de Molienda:");
System.out.println("Promedio: " + estadisticasMolienda.mean());
System.out.println("Máximo: " + estadisticasMolienda.max());
System.out.println("Mínimo: " + estadisticasMolienda.min());
System.out.println("Desviación Estándar: " + estadisticasMolienda.deviation());
estadisticasMaceracion();
estadisticasHervido();
estadisticasEnfriamiento();
estadisticasFermentacion();
estadisticasMaduracion();
System.out.println("Estadísticas de Embotellado:");
System.out.println("Promedio: " + estadisticasEmbotellado.mean());
System.out.println("Máximo: " + estadisticasEmbotellado.max());
System.out.println("Mínimo: " + estadisticasEmbotellado.min());
System.out.println("Desviación Estándar: " + estadisticasEmbotellado.deviation());

System.out.println("Estadísticas de Cajas:");
System.out.println("Promedio: " + estadisticasCajas.mean());
System.out.println("Máximo: " + estadisticasCajas.max());
System.out.println("Mínimo: " + estadisticasCajas.min());
System.out.println("Desviación Estándar: " + estadisticasCajas.deviation());

System.out.println("Estadísticas de Palets:");
System.out.println("Promedio: " + estadisticasPalets.mean());
System.out.println("Máximo: " + estadisticasPalets.max());
System.out.println("Mínimo: " + estadisticasPalets.min());
System.out.println("Desviación Estándar: " + estadisticasPalets.deviation());]]></DestroyCode>
