					<Body><![CDATA[    double promedio = calcularPromedio(tiemposMaceracion);
    double maximo = calcularMaximo(tiemposMaceracion);
    double minimo = calcularMinimo(tiemposMaceracion);
    double desviacion = calcularDesviacionEstandar(tiemposMaceracion);
    System.out.println("Estadísticas de Maceración:");
