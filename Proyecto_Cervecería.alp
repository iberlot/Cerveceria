				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1730251705671</Id>
					<Name><![CDATA[calcularPromedio]]></Name>
					<X>1220</X><Y>-160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[listaTiempos]]></Name>
						<Type><![CDATA[Object]]></Type>
					</Parameter>
					<Body><![CDATA[ArrayList<Double> tiempos = (ArrayList<Double>) listaTiempos;

if (tiempos.isEmpty()) return 0;

double suma = 0;
for (double tiempo : tiempos) {
    suma += tiempo;
}
return suma / tiempos.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1730252023913</Id>
					<Name><![CDATA[calcularMaximo]]></Name>
					<X>1220</X><Y>-140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[listaTiempos]]></Name>
						<Type><![CDATA[Object]]></Type>
					</Parameter>
					<Body><![CDATA[    ArrayList<Double> tiempos = (ArrayList<Double>) listaTiempos;
    if (tiempos.isEmpty()) return 0;
    
    double maximo = tiempos.get(0);
    for (double tiempo : tiempos) {
        if (tiempo > maximo) maximo = tiempo;
    }
    return maximo;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1730252117790</Id>
					<Name><![CDATA[calcularMinimo]]></Name>
					<X>1220</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[listaTiempos]]></Name>
						<Type><![CDATA[Object]]></Type>
					</Parameter>
					<Body><![CDATA[    ArrayList<Double> tiempos = (ArrayList<Double>) listaTiempos;
    if (tiempos.isEmpty()) return 0;
    
    double minimo = tiempos.get(0);
    for (double tiempo : tiempos) {
        if (tiempo < minimo) minimo = tiempo;
    }
    return minimo;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1730252144527</Id>
					<Name><![CDATA[calcularDesviacionEstandar]]></Name>
					<X>1220</X><Y>-100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[listaTiempos]]></Name>
						<Type><![CDATA[Object]]></Type>
					</Parameter>
					<Body><![CDATA[    ArrayList<Double> tiempos = (ArrayList<Double>) listaTiempos;
    if (tiempos.isEmpty()) return 0;
    
    double promedio = calcularPromedio(tiempos);
    double sumaCuadrados = 0;
    for (double tiempo : tiempos) {
        sumaCuadrados += Math.pow(tiempo - promedio, 2);
    }
    return Math.sqrt(sumaCuadrados / tiempos.size());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
