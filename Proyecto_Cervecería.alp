					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double tiempo = generarValorAleatorio(5, 7, cumpleProbabilidad(0.9));
double concentracionAlcohol = generarValorAleatorio(4.5, 6.5, cumpleProbabilidad(0.9));
    return tiempo >= 5 && tiempo <= 7 && concentracionAlcohol >= 4.5 && concentracionAlcohol <= 6.5;]]></Body>
				</Function>
