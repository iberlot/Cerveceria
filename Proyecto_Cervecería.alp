				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1729463406862</Id>
					<Name><![CDATA[cantidadLevadura]]></Name>
					<X>450</X><Y>-130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tipo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[    double factorLevadura;
    
    switch (tipo.toLowerCase()) {
        case "ipa":
            factorLevadura = 0.01;
            break;
        case "lager":
            factorLevadura = 0.008;
            break;
        case "ale":
            factorLevadura = 0.009;
            break;
        case "stout":
            factorLevadura = 0.007;
            break;
        default:
            factorLevadura = 0.008;
            break;
    }
 
    return (int) Math.ceil(500 * factorLevadura);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1729464862472</Id>
					<Name><![CDATA[embotellar]]></Name>
					<X>450</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double volumenCerveza = 550;
double capacidadBotella = 1; 
int botellasPorCaja = 12;
int totalBotellas;
int totalCajas;
    totalBotellas = (int) Math.ceil(volumenCerveza / capacidadBotella);
    
    totalCajas = (int) Math.ceil((double) totalBotellas / botellasPorCaja);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1729467147756</Id>
					<Name><![CDATA[cantidadMalta]]></Name>
					<X>450</X><Y>-150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tipo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[    double factorMalta; 
    
    switch (tipo.toLowerCase()) {
        case "ipa":
            factorMalta = 0.16;
            break;
        case "lager":
            factorMalta = 0.14;
            break;
        case "ale":
            factorMalta = 0.15;
            break;
        case "stout":
            factorMalta = 0.18;
            break;
        default:
            factorMalta = 0.15;
            break;
    }
    
    double cantidadMalta = 550 * factorMalta;
    
    return (int) Math.ceil(cantidadMalta);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
