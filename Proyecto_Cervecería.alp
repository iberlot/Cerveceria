					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double temperatura = generarValorAleatorio(0, 25, cumpleProbabilidad(0.9));
    return temperatura <= 25;]]></Body>
