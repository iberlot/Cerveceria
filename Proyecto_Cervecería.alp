					<X>760</X><Y>-40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double cantidadEmbotellada = generarValorAleatorio(1, 1, cumpleProbabilidad(0.9)); // Siempre será 1
String estadoBotellas = cumpleProbabilidad(0.9) ? "intacta" : "defectuosa";
    return cantidadEmbotellada == 1 && estadoBotellas.equals("intacta");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1729994637015</Id>
					<Name><![CDATA[generarValorAleatorio]]></Name>
					<X>1040</X><Y>-160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[minimo]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[maximo]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[dentroDeLimites]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[    if (dentroDeLimites) {
        return minimo + (Math.random() * (maximo - minimo));
    } else {
        // Genera un valor fuera de los límites: 5% por debajo del mínimo o 5% por encima del máximo
        return Math.random() < 0.5 ? minimo - (0.05 * minimo) : maximo + (0.05 * maximo);
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1729995603502</Id>
					<Name><![CDATA[cumpleProbabilidad]]></Name>
					<X>1040</X><Y>-140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[probabilidad]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return Math.random() <= probabilidad;]]></Body>
				</Function>
