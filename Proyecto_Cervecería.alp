					<Id>1729993250787</Id>
					<Name><![CDATA[verificarCalidadMolienda]]></Name>
					<X>760</X><Y>-160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double gradoMolienda = generarValorAleatorio(0.8, 1.2, cumpleProbabilidad(0.9));
    return gradoMolienda >= 0.8 && gradoMolienda <= 1.2;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1729993254954</Id>
					<Name><![CDATA[verificarCalidadMaceracion]]></Name>
					<X>760</X><Y>-140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double temperatura = generarValorAleatorio(65, 75, cumpleProbabilidad(0.9));
double tiempo = generarValorAleatorio(60, 90, cumpleProbabilidad(0.9));
    return temperatura >= 65 && temperatura <= 75 && tiempo >= 60 && tiempo <= 90;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1729993258710</Id>
					<Name><![CDATA[verificarCalidadHervido]]></Name>
					<X>760</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[ double cantidadLupulo = generarValorAleatorio(0.04, 0.08, cumpleProbabilidad(0.9));
 double temperatura = generarValorAleatorio(100, 105, cumpleProbabilidad(0.9));
    return cantidadLupulo >= 0.04 && cantidadLupulo <= 0.08 && temperatura >= 100 && temperatura <= 105;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
